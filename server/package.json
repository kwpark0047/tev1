{
  "name": "tev1-websocket-server",
  "version": "1.4.0",
  "description": "TEV1 realtime collaboration server (Socket.IO + PostgreSQL + Redis)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "test": "node tests/frontend-check.js && node tests/totp.test.js && node tests/qr.test.js && node tests/smoke.js && node tests/policy.test.js",
    "test:ci": "node tests/frontend-check.js && node tests/totp.test.js && node tests/qr.test.js && node tests/smoke.js && node tests/policy.test.js",
    "test:frontend": "node tests/frontend-check.js",
    "test:totp": "node tests/totp.test.js",
    "test:qr": "node tests/qr.test.js",
    "test:smoke": "node tests/smoke.js",
    "test:policy": "node tests/policy.test.js",
    "test:watch": "node tests/smoke.js",
    "docker:build": "docker build -t tev1-ws .",
    "docker:run": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "keywords": [
    "websocket",
    "real-time",
    "collaboration",
    "tev1"
  ],
  "author": "tev1 team",
  "license": "MIT",
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "googleapis": "^183.0.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.14",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.4",
    "uuid": "^11.1.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "socket.io-client": "^4.8.4"
  }
}
