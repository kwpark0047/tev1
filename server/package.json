{
  "name": "tev1-websocket-server",
  "version": "1.0.0",
  "description": "tev1 WebSocket Server for real-time logs, collaboration, and auth",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "docker:build": "docker build -t tev1-ws .",
    "docker:run": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "keywords": [
    "websocket",
    "real-time",
    "collaboration",
    "tev1"
  ],
  "author": "tev1 team",
  "license": "MIT",
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "googleapis": "^183.0.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.1",
    "redis": "^6.3.0",
    "socket.io": "^4.8.4",
    "uuid": "^9.0.1",
    "web-push": "^3.6.7",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "ws": "^8.16.0"
  }
}
