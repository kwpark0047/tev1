# TEV1 Server Environment Variables
# Copy this file to .env and fill in the actual values

# Database
DATABASE_URL=postgresql://tev1:secure_password@localhost:5432/tev1
POSTGRES_PASSWORD=secure_password

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-production

# Server
NODE_ENV=production
PORT=8081
CORS_ORIGIN=https://tev1.example.com
FRONTEND_URL=https://tev1.example.com

# Google OAuth (for Calendar integration)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://tev1.example.com/api/auth/google/callback

# ==========================================================
# 계정 정책
# ==========================================================
# 이메일 인증 강제: true 이면 (1) 가입 시 이메일 필수, (2) 미인증 계정 로그인 차단.
# NODE_ENV=production 이고 값이 없으면 자동으로 강제(true)됩니다.
# 강제를 끄려면 false 를 명시하세요.
# REQUIRE_EMAIL_VERIFICATION=true

# ==========================================================
# 메일 발송 (이메일 인증 / 비밀번호 재설정 / 초대)
# ==========================================================
# 아무 값도 설정하지 않으면 로컬 개발용 dev-outbox 모드로 동작하며,
# 발송 메일이 MAIL_OUTBOX_FILE(JSONL)에만 기록됩니다. 운영에서는 반드시 SMTP를 설정하세요.
# MAIL_FROM=tev1@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tev1@example.com
# SMTP_PASS=
# MAIL_OUTBOX_FILE=/tmp/tev1-outbox.jsonl

# Web Push (VAPID keys - generate with: npx web-push generate-vapid-keys)
# 실제 키를 커밋하지 마세요. 배포마다 새로 생성합니다:
#   npx web-push generate-vapid-keys
# 아래 값은 형식 예시이며 그대로 사용하면 안 됩니다.
VAPID_PUBLIC_KEY=Bxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPID_PRIVATE_KEY=Yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy

# Web Push 발신자 식별
VAPID_SUBJECT=mailto:admin@tev1.local

# Logging
LOG_LEVEL=info