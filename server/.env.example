# TEV1 Server Environment Variables
# Copy this file to .env and fill in the actual values

# Database
DATABASE_URL=postgresql://tev1:secure_password@localhost:5432/tev1
POSTGRES_PASSWORD=secure_password

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-production

# Server
NODE_ENV=production
PORT=8081
CORS_ORIGIN=https://tev1.example.com
FRONTEND_URL=https://tev1.example.com

# Google OAuth (for Calendar integration)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://tev1.example.com/api/auth/google/callback

# Web Push (VAPID keys - generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=BNWr6nQsvfmbisrq87l7pfDo3qyI1o8NjjVrcjz3VvkDBI1OPQAIxVq7ZUQUvbL1kJ-Rf3wBpUf68E7Di_PsOXs
VAPID_PRIVATE_KEY=WSYD0tkCJghVTy9gWcFS-Kd89V-T4cE04gbfUtZMX-g

# Web Push 발신자 식별
VAPID_SUBJECT=mailto:admin@tev1.local

# Logging
LOG_LEVEL=info